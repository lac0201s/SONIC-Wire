# SonicWire API configuration.
# Copy to apps/server/.env and edit. Every value here is optional: the defaults
# below are the ones used in development. Nothing secret belongs in this file.

# development | test | production
NODE_ENV=development

# Bind address and port. Use 127.0.0.1 for a laptop-only instance.
HOST=0.0.0.0
PORT=8787

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Where SQLite, media, quarantine, exports and tmp live. Relative to the CWD of
# the server process (apps/server when started through npm workspaces).
DATA_DIR=./var

# Development only: allow acquisition from loopback/private addresses. Leave
# false in production — it disables the SSRF guard's private-range refusal.
ALLOW_PRIVATE_NETWORK=false

# Byte caps and job limits. Every one of these is enforced, not advisory.
MAX_UPLOAD_BYTES=2147483648
MAX_DOWNLOAD_BYTES=1073741824
MAX_DOWNLOAD_SECONDS=900
JOB_WORKERS=2
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_TIMEOUT_SECONDS=1800

# Sessions and rate limiting.
SESSION_TTL_HOURS=336
RATE_LIMIT_MAX=600

# Override the bundled FFmpeg/FFprobe binaries. Leave blank to use the pinned
# @ffmpeg-installer builds so behaviour is identical across machines.
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# Serve the built web app (apps/web/dist) from the API process. Set by
# `npm start` at the repository root.
# WEB_DIST_DIR=../web/dist

# Extra origins allowed to call the API from a browser (comma separated). The
# Vite dev server proxies /api, so development normally needs nothing here.
ALLOWED_ORIGINS=

# Trust X-Forwarded-* headers. Enable only behind a proxy you control.
TRUST_PROXY=false

# Provider credentials. SonicWire refuses to fake a connection: a provider
# stays "not_configured" until its real credentials are supplied here.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# SOUNDCLOUD_CLIENT_ID=
# SOUNDCLOUD_CLIENT_SECRET=
# VIMEO_CLIENT_ID=
# VIMEO_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
